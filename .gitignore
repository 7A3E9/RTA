# --- Persistent storage ---
DATA_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "bot_data.json")

verified_users = {}
user_data = {}
user_balance = {}
promo_state = {"active": False, "percent": 0}

RANK_PRICES = {
    12: 50, 13: 70, 14: 100, 15: 150,
    16: 170, 17: 200, 18: 250, 19: 270,
    20: 300, 21: 250, 22: 270, 23: 300,
    26: 450, 27: 500
}

LOG_RANK_CHANNEL_ID = None
LOG_RANK_ENABLED = True

RANK_LIST_MESSAGE = {"channel_id": None, "message_id": None}
ADMIN_LIST_MESSAGE = {"channel_id": None, "message_id": None}


def load_data():
    global verified_users, user_data, user_balance, promo_state, RANK_PRICES, LOG_RANK_CHANNEL_ID, LOG_RANK_ENABLED
    global RANK_LIST_MESSAGE, ADMIN_LIST_MESSAGE
    if not os.path.exists(DATA_FILE):
        print("[load_data] No existing data file found, starting fresh.")
        promo_state = {"active": False, "percent": 0}
        LOG_RANK_CHANNEL_ID = None
        LOG_RANK_ENABLED = True
        return
    try:
        with open(DATA_FILE, "r", encoding="utf-8") as f:
            raw = json.load(f)

        verified_users = raw.get("verified_users", {})
        user_data = {int(k): v for k, v in raw.get("user_data", {}).items()}
        user_balance = raw.get("user_balance", {})

        promo_state = raw.get("promo_state", {"active": False, "percent": 0})
        LOG_RANK_CHANNEL_ID = raw.get("log_rank_channel_id")
        LOG_RANK_ENABLED = raw.get("log_rank_enabled", True)

        if "rank_prices" in raw:
            RANK_PRICES = {int(k): v for k, v in raw["rank_prices"].items()}

        RANK_LIST_MESSAGE = raw.get("rank_list_message", {"channel_id": None, "message_id": None})
        ADMIN_LIST_MESSAGE = raw.get("admin_list_message", {"channel_id": None, "message_id": None})

        print(f"[load_data] Loaded {len(user_data)} verified user(s) + settings from {DATA_FILE}")
    except Exception as e:
        print(f"[load_data] Failed to load {DATA_FILE}: {e}")
        promo_state = {"active": False, "percent": 0}
        LOG_RANK_CHANNEL_ID = None
        LOG_RANK_ENABLED = True


def save_data():
    try:
        raw = {
            "verified_users": verified_users,
            "user_data": {str(k): v for k, v in user_data.items()},
            "user_balance": user_balance,
            "promo_state": promo_state,
            "rank_prices": {str(k): v for k, v in RANK_PRICES.items()},
            "log_rank_channel_id": LOG_RANK_CHANNEL_ID,
            "log_rank_enabled": LOG_RANK_ENABLED,
            "rank_list_message": RANK_LIST_MESSAGE,
            "admin_list_message": ADMIN_LIST_MESSAGE,
        }
        with open(DATA_FILE, "w", encoding="utf-8") as f:
            json.dump(raw, f, ensure_ascii=False, indent=2)
        print("[save_data] Saved settings successfully")
    except Exception as e:
        print(f"[save_data] Failed to save {DATA_FILE}: {e}")


def apply_promo(base_price: int) -> int:
    if promo_state.get("active") and promo_state.get("percent", 0) > 0:
        discounted = base_price - (base_price * promo_state["percent"] // 100)
        return max(discounted, 0)
    return base_price


