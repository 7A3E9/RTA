class LogToggleView(discord.ui.View):
    def __init__(self):
        super().__init__(timeout=180)

    @discord.ui.button(label="เปิด Log ปรับยศ", style=discord.ButtonStyle.success, emoji="🟢")
    async def turn_on(self, interaction: discord.Interaction, button: discord.ui.Button):
        if not interaction.user.guild_permissions.administrator:
            await interaction.response.send_message("<a:1512789817811927070:1521852613690261737> แอดมินเท่านั้น", ephemeral=True)
            return
        global LOG_RANK_ENABLED
        LOG_RANK_ENABLED = True
        save_data()
        await interaction.response.edit_message(content="<a:1236208029246947339:1521848797326479462> **ระบบแจ้งเตือนการปรับยศถูกเปิดแล้ว**", view=None)

    @discord.ui.button(label="ปิด Log ปรับยศ", style=discord.ButtonStyle.danger, emoji="🔴")
    async def turn_off(self, interaction: discord.Interaction, button: discord.ui.Button):
        if not interaction.user.guild_permissions.administrator:
            await interaction.response.send_message("<a:1512789817811927070:1521852613690261737> แอดมินเท่านั้น", ephemeral=True)
            return
        global LOG_RANK_ENABLED
        LOG_RANK_ENABLED = False
        save_data()
        await interaction.response.edit_message(content="<a:1512789817811927070:1521852613690261737> **ระบบแจ้งเตือนการปรับยศถูกปิดแล้ว**", view=None)


