def extract_angpao_voucher_id(link: str):
    try:
        parsed = urllib.parse.urlparse(link.strip())
        query = urllib.parse.parse_qs(parsed.query)
        if query.get("v"):
            return query["v"][0]
        last_segment = parsed.path.rstrip("/").split("/")[-1]
        return last_segment or None
    except Exception:
        return None


async def _try_parse_json(resp):
    try:
        return await resp.json(), None
    except Exception:
        text = await resp.text()
        return None, text


def _extract_amount(data: dict):
    amount_raw = (
        data.get("amount")
        or (data.get("data") or {}).get("amount")
        or "0"
    )
    try:
        return int(float(str(amount_raw).strip()))
    except (TypeError, ValueError):
        return 0


async def check_angpao(link: str):
    voucher_id = extract_angpao_voucher_id(link)
    if not voucher_id:
        return 0, "ลิงก์ซองไม่ถูกต้อง"

    try:
        async with aiohttp.ClientSession() as session:
            payload = {"phone": ANGPAO_RECEIVER_PHONE, "voucher_id": voucher_id}
            async with session.post(
                "https://tmn-angpao.pages.dev/api",
                json=payload,
                headers={"Content-Type": "application/json", "Accept": "application/json"}
            ) as resp:
                data, raw = await _try_parse_json(resp)

                if data and isinstance(data, dict):
                    if data.get("success") or data.get("status") == "success":
                        amount = _extract_amount(data)
                        return amount, None
                    else:
                        code = data.get("code")
                        msg = ANGPAO_ERROR_MESSAGES.get(code, data.get("message") or str(data))
                        return 0, msg
                else:
                    return 0, "เซิร์ฟเวอร์ตอบกลับไม่ถูกต้อง กรุณาลองใหม่"
    except Exception as e:
        print(f"[check_angpao] Error: {e}")
        return 0, "เกิดข้อผิดพลาดในการเชื่อมต่อ"


async def log_topup(interaction, amount, roblox_name):
    log_channel = bot.get_channel(LOG_CHANNEL_ID)
    if log_channel:
        time = datetime.datetime.now().strftime("%d/%m/%Y %H:%M")
        log_embed = discord.Embed(
            title="📌 บันทึกการเติมเงิน",
            description=f"**ผู้ใช้:** {interaction.user.mention}\n**บัญชี Roblox:** {roblox_name}\n**ยอด:** {amount} บาท\n**เวลา:** {time}",
            color=discord.Color.green()
        )
        await log_channel.send(embed=log_embed)


class MainView(discord.ui.View):
    def __init__(self):
        super().__init__(timeout=None)

    @discord.ui.button(label="ยืนยันข้อมูล", style=discord.ButtonStyle.primary, emoji="<a:1236208029246947339:1521848797326479462>", custom_id="verify_btn", row=0)
    async def verify(self, interaction: discord.Interaction, button: discord.ui.Button):
        await interaction.response.defer(ephemeral=True)
        member = interaction.guild.get_member(interaction.user.id)
        nickname = member.nick if member.nick else interaction.user.name
        roblox_name = nickname.split("|")[-1].strip() if "|" in nickname else nickname.strip()

        if roblox_name in verified_users and verified_users[roblox_name] != interaction.user.id:
            await interaction.followup.send("<a:1512789817811927070:1521852613690261737> ชื่อ Roblox นี้ถูกยืนยันโดยผู้ใช้อื่นแล้ว", ephemeral=True)
            return

        rank, success = await get_roblox_rank(roblox_name)
        if success:
            verified_users[roblox_name] = interaction.user.id
            user_data[interaction.user.id] = roblox_name
            save_data()

            embed = discord.Embed(
                title="ระบบได้ทำการตรวจสอบข้อมูลแล้ว <a:1236208029246947339:1521848797326479462>",
                description=f"> [ 𝙐𝙨𝙚𝙧𝙣𝙖𝙢𝙚 𝙍𝙤𝙗𝙡𝙤𝙭 | **{roblox_name}** ]",
                color=discord.Color.gold()
            )
            await interaction.followup.send(embed=embed, ephemeral=True)
        else:
            await interaction.followup.send("<a:1512789817811927070:1521852613690261737> ไม่พบผู้ใช้บน Roblox", ephemeral=True)

    @discord.ui.button(label="โดเนท | ยศ", style=discord.ButtonStyle.primary, emoji="<:1389806861816959096:1521878501073096906>", custom_id="buyrank_btn", row=0)
    async def buy_rank(self, interaction: discord.Interaction, button: discord.ui.Button):
        username = user_data.get(interaction.user.id)
        if not username:
            await interaction.response.send_message("<a:1512789817811927070:1521852613690261737> กรุณายืนยันข้อมูลก่อน", ephemeral=True)
            return

        current_rank, _ = await get_roblox_rank(username)
        roles = await get_group_roles()

        if not roles:
            await interaction.response.send_message("<a:1512789817811927070:1521852613690261737> ไม่สามารถโหลดข้อมูลยศจากกลุ่มได้ในขณะนี้", ephemeral=True)
            return

        view = RankSelectView(username, roles, current_rank)
        if not view.has_options:
            await interaction.response.send_message("<a:1512789817811927070:1521852613690261737> ไม่พบยศที่สามารถซื้อได้", ephemeral=True)
            return

        await interaction.response.send_message(f"# เลือกยศที่ต้องการซื้อ\n> ยศปัจจุบัน: **{current_rank}**", view=view, ephemeral=True)

    @discord.ui.button(label="เช็คข้อมูล", style=discord.ButtonStyle.gray, emoji="<a:1519586474910027786:1521849086519676950>", custom_id="check_btn", row=1)
    async def check(self, interaction: discord.Interaction, button: discord.ui.Button):
        user_id = interaction.user.id
        username = user_data.get(user_id)
        if not username:
            await interaction.response.send_message("<a:1512789817811927070:1521852613690261737> กรุณายืนยันข้อมูลก่อน", ephemeral=True)
            return

        rank, _ = await get_roblox_rank(username)
        balance = user_balance.get(username, 0)

        embed = discord.Embed(
            title="ข้อมูลของคุณ <a:1449745750325203135:1520307935744360578>",
            description="**กรุณาตรวจสอบว่าข้อมูลด้านล่างคือบัญชีของคุณ ก่อนเลือกซื้อยศ**",
            color=discord.Color.gold()
        )
        embed.add_field(name="", value=f"`Roblox : {username}`", inline=False)
        embed.add_field(name="", value=f"`ยศปัจจุบัน : {rank}`", inline=False)
        embed.add_field(name="", value=f"`ยอดคงเหลือ : {balance} ฿`", inline=False)
        embed.set_footer(text='ข้อมูลจากกลุ่ม("[ RLA ] Royal Lego Army")')

        await interaction.response.send_message(embed=embed, ephemeral=True)

    @discord.ui.button(label="เติมเงินซองอั่งเปา", style=discord.ButtonStyle.success, emoji="<a:1518553850330611763:1520307963330560101>", custom_id="topup_btn", row=1)
    async def topup(self, interaction: discord.Interaction, button: discord.ui.Button):
        username = user_data.get(interaction.user.id)
        if not username:
            await interaction.response.send_message("<a:1512789817811927070:1521852613690261737> กรุณายืนยันข้อมูลก่อน", ephemeral=True)
            return

        if interaction.user.guild_permissions.administrator:
            class AdminTopupChoiceView(discord.ui.View):
                def __init__(self, roblox_name: str):
                    super().__init__(timeout=60)
                    self.roblox_name = roblox_name

                @discord.ui.button(label="กรอกจำนวนเงิน", style=discord.ButtonStyle.primary)
                async def manual(self, inter: discord.Interaction, btn: discord.ui.Button):
                    await inter.response.send_modal(AdminTopupModal(self.roblox_name))

                @discord.ui.button(label="ใช้ซองอั่งเปา", style=discord.ButtonStyle.success)
                async def angpao(self, inter: discord.Interaction, btn: discord.ui.Button):
                    await inter.response.send_modal(AdminAngpaoTopupModal(self.roblox_name))

            await interaction.response.send_message("**เลือกวิธีเติมเงิน (ผู้ดูแล)**", view=AdminTopupChoiceView(username), ephemeral=True)
        else:
            modal = TopupModal(username)
            await interaction.response.send_modal(modal)


class TopupModal(discord.ui.Modal, title="เติมเงินด้วยซองอั่งเปา"):
    link = discord.ui.TextInput(label="ลิงก์ซองอั่งเปา", placeholder="https://gift.truemoney.com/...", required=True)

    def __init__(self, roblox_name: str):
        super().__init__()
        self.roblox_name = roblox_name

    async def on_submit(self, interaction: discord.Interaction):
        await interaction.response.defer(ephemeral=True)
        amount, error = await check_angpao(self.link.value)

        if amount > 0:
            user_balance[self.roblox_name] = user_balance.get(self.roblox_name, 0) + amount
            save_data()
            await log_topup(interaction, amount, self.roblox_name)
            await interaction.followup.send(f"<a:1236208029246947339:1521848797326479462> เติมเงินสำเร็จ +{amount} บาท (บัญชี Roblox: {self.roblox_name})", ephemeral=True)
        else:
            await interaction.followup.send(f"<a:1512789817811927070:1521852613690261737> {error or 'ไม่สามารถรับเงินจากซองนี้ได้'}", ephemeral=True)


class AdminTopupModal(discord.ui.Modal, title="เติมเงิน (ผู้ดูแล)"):
    amount = discord.ui.TextInput(label="จำนวนเงิน (บาท)", placeholder="100", required=True)

    def __init__(self, roblox_name: str):
        super().__init__()
        self.roblox_name = roblox_name

    async def on_submit(self, interaction: discord.Interaction):
        await interaction.response.defer(ephemeral=True)
        try:
            amount = int(self.amount.value)
            if amount <= 0:
                await interaction.followup.send("<a:1512789817811927070:1521852613690261737> กรุณากรอกจำนวนเงินมากกว่า 0", ephemeral=True)
                return
        except ValueError:
            await interaction.followup.send("<a:1512789817811927070:1521852613690261737> กรุณากรอกตัวเลข", ephemeral=True)
            return
        user_balance[self.roblox_name] = user_balance.get(self.roblox_name, 0) + amount
        save_data()
        await log_topup(interaction, amount, self.roblox_name)
        await interaction.followup.send(f"<a:1236208029246947339:1521848797326479462> เติมเงินสำเร็จ +{amount} บาท (ผู้ดูแล) (บัญชี Roblox: {self.roblox_name})", ephemeral=True)


class AdminAngpaoTopupModal(discord.ui.Modal, title="เติมเงินด้วยซองอั่งเปา (ผู้ดูแล)"):
    link = discord.ui.TextInput(label="ลิงก์ซองอั่งเปา", placeholder="https://gift.truemoney.com/...", required=True)

    def __init__(self, roblox_name: str):
        super().__init__()
