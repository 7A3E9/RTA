LOG_CHANNEL_ID = 1522151871748374599


async def get_group_roles():
    async with aiohttp.ClientSession() as session:
        try:
            async with session.get(f"https://groups.roblox.com/v1/groups/{GROUP_ID}/roles") as resp:
                if resp.status != 200:
                    print(f"[get_group_roles] HTTP {resp.status}: {await resp.text()}")
                    return {}
                data = await resp.json()
                roles = {
                    role["id"]: {"name": role["name"], "rank": role["rank"]}
                    for role in data.get("roles", [])
                    if role["rank"] > 0
                }
                return roles
        except Exception as e:
            print(f"[get_group_roles] Exception: {e}")
            return {}


async def get_roblox_rank(username: str):
    async with aiohttp.ClientSession() as session:
        try:
            payload = {"usernames": [username]}
            async with session.post("https://users.roblox.com/v1/usernames/users", json=payload) as resp:
                data = await resp.json()
                if not data.get("data"):
                    return "ไม่พบผู้ใช้", False
                user_id = data["data"][0]["id"]
            async with session.get(f"https://groups.roblox.com/v2/users/{user_id}/groups/roles") as resp:
                data = await resp.json()
                for group in data.get("data", []):
                    if group["group"]["id"] == GROUP_ID:
                        return group["role"]["name"], True
                return "สมาชิกทั่วไป", True
        except Exception as e:
            print(f"[get_roblox_rank] Exception: {e}")
            return "เกิดข้อผิดพลาด", False


async def change_roblox_rank(roblox_name: str, role_id: int):
    try:
        async with aiohttp.ClientSession() as session:
            payload = {"usernames": [roblox_name]}
            async with session.post("https://users.roblox.com/v1/usernames/users", json=payload) as resp:
                data = await resp.json()
                if not data.get("data"):
                    return False
                user_id = data["data"][0]["id"]

            old_rank = "ไม่ทราบ"
            async with session.get(f"https://groups.roblox.com/v2/users/{user_id}/groups/roles") as resp:
                data = await resp.json()
                for group in data.get("data", []):
                    if group["group"]["id"] == GROUP_ID:
                        old_rank = group["role"]["name"]
                        break

            headers = {
                "Cookie": f".ROBLOSECURITY={ROBLOX_COOKIE}",
                "Content-Type": "application/json",
                "Referer": "https://www.roblox.com/"
            }
            async with session.post("https://auth.roblox.com/v2/logout", headers=headers) as resp:
                csrf = resp.headers.get("x-csrf-token")
                if csrf:
                    headers["X-CSRF-TOKEN"] = csrf

            async with session.patch(
                f"https://groups.roblox.com/v1/groups/{GROUP_ID}/users/{user_id}",
                json={"roleId": role_id},
                headers=headers
            ) as resp:
                ok = resp.status in (200, 204)
                if ok:
                    await asyncio.sleep(2)
                    new_rank = "ไม่ทราบ"
                    for attempt in range(3):
                        async with session.get(f"https://groups.roblox.com/v2/users/{user_id}/groups/roles") as resp2:
                            data2 = await resp2.json()
                            for group in data2.get("data", []):
                                if group["group"]["id"] == GROUP_ID:
                                    new_rank = group["role"]["name"]
                                    break
                        if new_rank != old_rank and new_rank != "ไม่ทราบ":
                            break
                        await asyncio.sleep(1.5)

                    await log_rank_change(roblox_name, old_rank, new_rank, "บอท (ระบบโดเนท)")
                return ok
    except Exception as e:
        print(f"[change_roblox_rank] Exception: {e}")
        return False


async def log_rank_change(username: str, old_rank: str, new_rank: str, changer: str = "ไม่ทราบ"):
    if not LOG_RANK_ENABLED or not LOG_RANK_CHANNEL_ID:
        return
    channel = bot.get_channel(LOG_RANK_CHANNEL_ID)
    if not channel:
        return

    embed = discord.Embed(
        title="<a:1515615849845756015:1520378175731929098> แจ้งเตือนการปรับยศ",
        color=discord.Color.blue()
    )
    embed.add_field(name="ชื่อผู้ปรับยศ", value=changer, inline=False)
    embed.add_field(name="ผู้ถูกปรับยศ", value=username, inline=False)
    embed.add_field(name="ยศเดิม", value=old_rank, inline=False)
    embed.add_field(name="ยศปัจจุบัน", value=new_rank, inline=False)
    embed.add_field(name="กลุ่ม", value="Thai Armed Forces Operation", inline=False)

    await channel.send(embed=embed)


