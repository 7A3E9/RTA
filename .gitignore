@bot.tree.command(name="เติมเงิน", description="เติมเงินให้ผู้ใช้ (เฉพาะแอดมิน)")
@app_commands.default_permissions(administrator=True)
async def slash_give_money(interaction: discord.Interaction, user: discord.Member, amount: int):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("<a:1512789817811927070:1521852613690261737> คำสั่งนี้ใช้ได้เฉพาะแอดมินเท่านั้น", ephemeral=True)
        return

    if amount <= 0:
        await interaction.response.send_message("<a:1512789817811927070:1521852613690261737> กรุณาระบุจำนวนเงินมากกว่า 0", ephemeral=True)
        return

    roblox_name = user_data.get(user.id)
    if not roblox_name:
        await interaction.response.send_message(f"<a:1512789817811927070:1521852613690261737> {user.mention} ยังไม่ได้กดยืนยันข้อมูล Roblox", ephemeral=True)
        return

    user_balance[roblox_name] = user_balance.get(roblox_name, 0) + amount
    save_data()
    await log_topup(interaction, amount, roblox_name)

    embed = discord.Embed(
        title="<a:1236208029246947339:1521848797326479462> เติมเงินสำเร็จ (แอดมิน)",
        description=f"**ผู้ใช้ Discord:** {user.mention}\n**บัญชี Roblox:** {roblox_name}\n**จำนวนที่เติม:** +{amount} ฿\n**ยอดคงเหลือ:** {user_balance[roblox_name]} ฿",
        color=discord.Color.green()
    )
    await interaction.response.send_message(embed=embed, ephemeral=True)


@bot.tree.command(name="เติมเงินทั้งหมด", description="เติมเงินให้ผู้ใช้ที่ยืนยันข้อมูลแล้วทุกคน (เฉพาะแอดมิน)")
@app_commands.default_permissions(administrator=True)
async def slash_give_money_all(interaction: discord.Interaction, amount: int):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("<a:1512789817811927070:1521852613690261737> คำสั่งนี้ใช้ได้เฉพาะแอดมินเท่านั้น", ephemeral=True)
        return

    if amount <= 0:
        await interaction.response.send_message("<a:1512789817811927070:1521852613690261737> กรุณาระบุจำนวนเงินมากกว่า 0", ephemeral=True)
        return

    recipient_count = len(verified_users)
    if recipient_count == 0:
        await interaction.response.send_message("<a:1512789817811927070:1521852613690261737> ยังไม่มีผู้ใช้ที่ยืนยันข้อมูล Roblox", ephemeral=True)
        return

    confirm_embed = discord.Embed(
        title="⚠️ ยืนยันการเติมเงินให้ทุกคน",
        description=f"กำลังจะเติมเงิน **+{amount} ฿** ให้กับผู้ใช้ที่ยืนยันข้อมูลแล้วทั้งหมด **{recipient_count} บัญชี**\nรวมเป็นเงินทั้งหมด **{amount * recipient_count} ฿**",
        color=discord.Color.orange()
    )
    # ใส่ ConfirmGiveAllView ด้านล่าง (ถ้าต้องการใช้เต็มรูปแบบ)


class ConfirmGiveAllView(discord.ui.View):
    def __init__(self, amount: int, admin_id: int):
        super().__init__(timeout=60)
        self.amount = amount
        self.admin_id = admin_id
        self.done = False

    async def interaction_check(self, interaction: discord.Interaction) -> bool:
        if interaction.user.id != self.admin_id:
            await interaction.response.send_message("<a:1512789817811927070:1521852613690261737> เฉพาะแอดมินที่สั่งคำสั่งนี้", ephemeral=True)
            return False
        return True

    @discord.ui.button(label="ยืนยัน เติมเงินให้ทุกคน", style=discord.ButtonStyle.success)
    async def confirm(self, interaction: discord.Interaction, button: discord.ui.Button):
        self.done = True
        for child in self.children:
            child.disabled = True

        for roblox_name in list(verified_users.keys()):
            user_balance[roblox_name] = user_balance.get(roblox_name, 0) + self.amount
        save_data()

        result_embed = discord.Embed(
            title="<a:1236208029246947339:1521848797326479462> เติมเงินให้ทุกคนสำเร็จ",
            description=f"**จำนวนต่อคน:** +{self.amount} ฿\n**จำนวนผู้ได้รับ:** {len(verified_users)} บัญชี",
            color=discord.Color.green()
        )
        await interaction.response.edit_message(embed=result_embed, view=self)

    @discord.ui.button(label="ยกเลิก", style=discord.ButtonStyle.danger)
    async def cancel(self, interaction: discord.Interaction, button: discord.ui.Button):
        self.done = True
        for child in self.children:
            child.disabled = True
        await interaction.response.edit_message(content="ยกเลิกการเติมเงินให้ทุกคน", view=self)


# ระบบพิมพ์ (นำกลับมา)
def parse_hex_color(value: str):
    if not value:
        return None
    v = value.strip().lstrip("#")
    if len(v) != 6:
        return None
    try:
        return discord.Color(int(v, 16))
    except ValueError:
        return None


class SayMessageModal(discord.ui.Modal, title="พิมพ์ข้อความ"):
    message = discord.ui.TextInput(label="ข้อความ", style=discord.TextStyle.paragraph, required=True, max_length=4000)
    title_input = discord.ui.TextInput(label="หัวข้อ (Embed)", required=False, max_length=256)
    footer_input = discord.ui.TextInput(label="ข้อความท้าย (Embed)", required=False, max_length=2048)

    def __init__(self, channel, send_method, color, upload_file):
        super().__init__()
        self.channel = channel
        self.send_method = send_method
        self.color = color
        self.upload_file = upload_file

    async def on_submit(self, interaction: discord.Interaction):
        message = self.message.value
        if self.send_method == "plain":
            if self.upload_file:
                await self.channel.send(content=message, file=self.upload_file)
            else:
                await self.channel.send(message)
        else:
            embed_color = discord.Color.blurple()
            if self.color:
                parsed = parse_hex_color(self.color)
                if parsed:
                    embed_color = parsed

            embed = discord.Embed(description=message, color=embed_color)
            if self.title_input.value:
                embed.title = self.title_input.value
            if self.footer_input.value:
                embed.set_footer(text=self.footer_input.value)

            if self.upload_file:
                embed.set_image(url=f"attachment://{self.upload_file.filename}")
                await self.channel.send(embed=embed, file=self.upload_file)
            else:
                await self.channel.send(embed=embed)

        await interaction.response.send_message(f"<a:1236208029246947339:1521848797326479462> ส่งข้อความไปที่ {self.channel.mention} แล้ว", ephemeral=True)


@bot.tree.command(name="พิมพ์", description="ให้บอทส่งข้อความ/Embed ไปยังช่องที่กำหนด (เฉพาะแอดมิน)")
@app_commands.default_permissions(administrator=True)
async def slash_say(interaction: discord.Interaction, channel: typing.Union[discord.TextChannel, discord.VoiceChannel], method: app_commands.Choice[str] = None, color: str = None, image: discord.Attachment = None):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("<a:1512789817811927070:1521852613690261737> คำสั่งนี้ใช้ได้เฉพาะแอดมินเท่านั้น", ephemeral=True)
        return

    send_method = method.value if method else "embed"
    upload_file = None
    if image:
        file_bytes = await image.read()
        upload_file = discord.File(io.BytesIO(file_bytes), filename=image.filename)

    await interaction.response.send_modal(SayMessageModal(channel, send_method, color, upload_file))


# ==================== Bot Settings ====================
class PromoPercentModal(discord.ui.Modal, title="ตั้งค่าโปรโมชั่นยศ"):
    percent = discord.ui.TextInput(label="ลดกี่เปอร์เซ็นต์", placeholder="เช่น 15", required=True, max_length=3)

    async def on_submit(self, interaction: discord.Interaction):
        try:
            value = int(self.percent.value)
        except ValueError:
            await interaction.response.send_message("<a:1512789817811927070:1521852613690261737> กรุณากรอกตัวเลขเท่านั้น", ephemeral=True)
            return
        if not (1 <= value <= 100):
            await interaction.response.send_message("<a:1512789817811927070:1521852613690261737> กรุณากรอกเปอร์เซ็นต์ระหว่าง 1-100", ephemeral=True)
            return

        promo_state["active"] = True
        promo_state["percent"] = value
        save_data()
        await refresh_rank_list_message()
        await interaction.response.edit_message(embed=build_bot_settings_embed(), view=BotSettingsView())


class AddRankModal(discord.ui.Modal, title="เพิ่มยศใหม่"):
    rank_input = discord.ui.TextInput(label="Rank (1-255)", placeholder="ตัวอย่าง: 15", required=True, max_length=3)
    price_input = discord.ui.TextInput(label="ราคา (บาท)", placeholder="ตัวอย่าง: 150", required=True, max_length=6)

    async def on_submit(self, interaction: discord.Interaction):
        try:
            rank = int(self.rank_input.value)
            price = int(self.price_input.value)
            if not (1 <= rank <= 255) or price <= 0:
                await interaction.response.send_message("<a:1512789817811927070:1521852613690261737> Rank ต้องอยู่ระหว่าง 1-255 และราคาต้องมากกว่า 0", ephemeral=True)
                return
        except ValueError:
            await interaction.response.send_message("<a:1512789817811927070:1521852613690261737> กรุณากรอกตัวเลขเท่านั้น", ephemeral=True)
            return

        RANK_PRICES[rank] = price
        save_data()
        await refresh_rank_list_message()
        await interaction.response.edit_message(embed=build_bot_settings_embed(), view=BotSettingsView())
        await interaction.followup.send(f"<a:1236208029246947339:1521848797326479462> เพิ่มยศ rank **{rank}** ราคา **{price} บาท** เรียบร้อยแล้ว", ephemeral=True)


class RemoveRankModal(discord.ui.Modal, title="ลบยศ"):
    rank_input = discord.ui.TextInput(label="Rank ที่ต้องการลบ", placeholder="ตัวอย่าง: 15", required=True, max_length=3)

    async def on_submit(self, interaction: discord.Interaction):
        try:
            rank = int(self.rank_input.value)
        except ValueError:
            await interaction.response.send_message("<a:1512789817811927070:1521852613690261737> กรุณากรอกตัวเลข", ephemeral=True)
            return

        if rank not in RANK_PRICES:
            await interaction.response.send_message(f"<a:1512789817811927070:1521852613690261737> ไม่พบยศ rank **{rank}** ในรายการ", ephemeral=True)
            return

        del RANK_PRICES[rank]
        save_data()
        await refresh_rank_list_message()
        await interaction.response.edit_message(embed=build_bot_settings_embed(), view=BotSettingsView())
        await interaction.followup.send(f"<a:1236208029246947339:1521848797326479462> ลบยศ rank **{rank}** เรียบร้อยแล้ว", ephemeral=True)


class BotSettingsView(discord.ui.View):
    def __init__(self):
        super().__init__(timeout=None)

    @discord.ui.select(
        placeholder="เลือกตัวเลือก",
        custom_id="bot_settings_select",
        options=[
            discord.SelectOption(label="เปิดโปรโมชั่นยศ", description="เปิดใช้งานส่วนลดราคายศทั้งหมด", emoji="<a:1519680484790112416:1520308598490665071>", value="promo_on"),
            discord.SelectOption(label="ปิดโปรโมชั่นยศ", description="ปิดการใช้งานส่วนลดราคายศ", emoji="<a:1519680543128551690:1521862768435920999>", value="promo_off"),
            discord.SelectOption(label="เพิ่มยศ", description="เพิ่มยศเข้าไปในรายการขาย", emoji="<a:1519680484790112416:1520308598490665071>", value="add_rank"),
            discord.SelectOption(label="ลบยศ", description="ลบยศออกจากรายการขาย", emoji="<a:1519680543128551690:1521862768435920999>", value="remove_rank")
        ]
    )
    async def settings_select(self, interaction: discord.Interaction, select: discord.ui.Select):
        if not interaction.user.guild_permissions.administrator:
            await interaction.response.send_message("<a:1512789817811927070:1521852613690261737> เฉพาะแอดมินเท่านั้น", ephemeral=True)
            return

        choice = select.values[0]
        if choice == "promo_on":
            await interaction.response.send_modal(PromoPercentModal())
        elif choice == "promo_off":
            promo_state["active"] = False
            save_data()
            await refresh_rank_list_message()
            await interaction.response.edit_message(embed=build_bot_settings_embed(), view=self)
        elif choice == "add_rank":
            await interaction.response.send_modal(AddRankModal())
        elif choice == "remove_rank":
            await interaction.response.send_modal(RemoveRankModal())

    @discord.ui.button(label="แสดงรายการยศ", emoji="<:ddd:1520268725373108315>", style=discord.ButtonStyle.gray, custom_id="show_rank_list_btn", row=1)
    async def show_rank_list(self, interaction: discord.Interaction, button: discord.ui.Button):
        embed = await build_rank_list_embed()
        await interaction.response.send_message(embed=embed, ephemeral=True)


@bot.tree.command(name="ตั้งค่าระบบโดเนท", description="ตั้งค่าระบบบอทโดเนท (เฉพาะแอดมิน)")
@app_commands.default_permissions(administrator=True)
async def slash_bot_settings(interaction: discord.Interaction):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("<a:1512789817811927070:1521852613690261737> คำสั่งนี้ใช้ได้เฉพาะแอดมินเท่านั้น", ephemeral=True)
        return
    await interaction.response.send_message(embed=build_bot_settings_embed(), view=BotSettingsView())


async def build_rank_list_embed():
    roles = await get_group_roles()
    rank_to_name = {info["rank"]: info["name"] for info in roles.values()}

    lines = ["# <a:1389806861816959096:1522125011039682692> รายการยศทั้งหมดในบอทขายยศ"]
    if not RANK_PRICES:
        lines.append("> ยังไม่มียศที่เปิดขายในตอนนี้")
    else:
        for rank in sorted(RANK_PRICES.keys()):
            base_price = RANK_PRICES[rank]
            price = apply_promo(base_price)
            name = rank_to_name.get(rank, "(ไม่พบชื่อยศนี้ในกลุ่ม Roblox แล้ว)")
            if promo_state.get("active") and promo_state.get("percent", 0) > 0:
                lines.append(f"> **{name}** · rank {rank} — ~~{base_price}~~ **{price} บาท** (ลด {promo_state['percent']}%)")
            else:
                lines.append(f"> **{name}** · rank {rank} — **{price} บาท**")

    return discord.Embed(description="\n".join(lines), color=discord.Color.gold())


async def refresh_rank_list_message():
    channel_id = RANK_LIST_MESSAGE.get("channel_id")
    message_id = RANK_LIST_MESSAGE.get("message_id")
    if not channel_id or not message_id:
        return
    channel = bot.get_channel(channel_id)
    if not channel:
        return
    try:
        embed = await build_rank_list_embed()
        await channel.get_partial_message(message_id).edit(embed=embed)
    except (discord.NotFound, discord.Forbidden):
        RANK_LIST_MESSAGE["channel_id"] = None
        RANK_LIST_MESSAGE["message_id"] = None
        save_data()
    except Exception as e:
        print(f"[refresh_rank_list_message] Exception: {e}")


@bot.event
async def on_ready():
    load_data()
    bot.add_view(MainView())
    bot.add_view(BotSettingsView())
    try:
        synced = await bot.tree.sync()
        print(f"[on_ready] Synced {len(synced)} slash command(s)")
    except Exception as e:
        print(f"[on_ready] Slash command sync failed: {e}")
    print(f"บอทออนไลน์: {bot.user}")


bot.run(DISCORD_BOT_TOKEN)
