        else:
            await interaction.followup.send(f"<a:1512789817811927070:1521852613690261737> {error or 'ไม่สามารถรับเงินจากซองนี้ได้'}", ephemeral=True)


class RankSelectView(discord.ui.View):
    def __init__(self, roblox_name: str, roles: dict, current_rank: str):
        super().__init__(timeout=300)
        self.roblox_name = roblox_name
        self.roles = roles

        options = []
        for role_id, info in roles.items():
            rank = info["rank"]
            name = info["name"]
            if rank in RANK_PRICES:
                base_price = RANK_PRICES[rank]
                price = apply_promo(base_price)
                if promo_state.get("active") and promo_state.get("percent", 0) > 0:
                    desc = f"ราคา {price} บาท (ลด {promo_state['percent']}% จาก {base_price} บาท) · rank {rank}"
                else:
                    desc = f"ราคา {price} บาท · rank {rank}"
                options.append(discord.SelectOption(label=name, description=desc, value=str(role_id)))

        self.has_options = bool(options)
        if self.has_options:
            self.select = discord.ui.Select(placeholder="เลือกยศที่ต้องการ", options=options, custom_id="rank_select_menu")
            self.select.callback = self.select_callback
            self.add_item(self.select)

    async def select_callback(self, interaction: discord.Interaction):
        await interaction.response.defer(ephemeral=True)
        role_id = int(self.select.values[0])
        role_info = self.roles.get(role_id, {"name": "Unknown", "rank": 0})
        rank_name = role_info["name"]

        base_price = RANK_PRICES.get(role_info["rank"], 0)
        price = apply_promo(base_price)

        current_balance = user_balance.get(self.roblox_name, 0)
        if current_balance < price:
            embed = discord.Embed(title="<a:1512789817811927070:1521852613690261737> ยอดเงินไม่พอ",
                                  description=f"**ยศ {rank_name} ราคา {price} ฿**\n**คุณมี {current_balance} ฿ · ขาดอีก {price - current_balance} ฿**",
                                  color=discord.Color.red())
            await interaction.followup.send(embed=embed, ephemeral=True)
            return

        success = await change_roblox_rank(self.roblox_name, role_id)
        if success:
            user_balance[self.roblox_name] = current_balance - price
            save_data()
            embed = discord.Embed(title="<a:1236208029246947339:1521848797326479462> ซื้อยศเสร็จสิ้น", description="**เปลี่ยนยศ Roblox แล้ว**", color=discord.Color.green())
            embed.add_field(name="", value=f"```lua\nชื่อผู้ใช้ Roblox : {self.roblox_name}\nยศโดเนทที่ได้รับ : {rank_name}\nเงินที่เสียไป : -{price} ฿\nเงินคงเหลือ : {user_balance[self.roblox_name]} ฿```", inline=False)
            await interaction.followup.send(embed=embed, ephemeral=True)
        else:
            await interaction.followup.send("<a:1512789817811927070:1521852613690261737> ไม่สามารถเปลี่ยนยศได้", ephemeral=True)


